# Copy to .env and fill in ONE key -- the one matching LLM_MODEL in chatbot.py.
# .env is gitignored (.gitignore has *.env). Never commit a real key.
#
# Chainlit loads .env on import, from the CURRENT WORKING DIRECTORY, so this file
# must sit wherever you run `uv run chainlit run chatbot.py`.

# Which model drives the chatbot. Read from here so nobody commits a model switch.
# Verified on Argo 17 Sep: claudesonnet45, claudehaiku45, gpt4o, gpto3, gpt41.
# claudeopus4 and gemini25pro return HTTP 500 from Argo itself.
LLM_MODEL=openrouter/google/gemma-4-26b-a4b-it

# LLM_MODEL=argo/claudesonnet45
# Argonne Argo gateway. Argonne network only -- apps.inside.anl.gov does not resolve
# on public DNS, and every call hangs off-network. Both gates are required: the
# network AND your username on the division authorized list. An unauthorised
# username gets HTTP 200 with "ACCESS DENIED" as the reply text, not an error.
ARGO_USER=

OPENROUTER_API_KEY=

# LLM_MODEL="anthropic/claude-opus-5"
# load_chat_model() already supports this provider; ChatAnthropic reads the key itself.
ANTHROPIC_API_KEY=

# LLM_MODEL="mistralai/mistral-small-latest"
MISTRAL_API_KEY=

# LLM_MODEL="ollama/gemma4"  needs a local ollama daemon and no key at all.

# Optional. No MCP server in this repo requires it. NCBI E-utilities allows
# 3 requests/second anonymously; a key raises that to 10/s.
NCBI_API_KEY=
